{
  "name": "retrodrive-launcher",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "skills:validate": "node scripts/validate-skills.mjs",
    "skills:manifest": "node scripts/validate-skills.mjs --write",
    "test:imports": "pwsh -NoProfile -File scripts/test-game-import.ps1",
    "prepare:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-restic.ps1",
    "check": "pnpm skills:validate && pnpm test:imports && pnpm prepare:backup && pnpm build && cargo test --manifest-path src-tauri/Cargo.toml",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "release:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-release.ps1",
    "release:patch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1 -Bump patch",
    "release:minor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1 -Bump minor",
    "release:major": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1 -Bump major",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "licenses": "pnpm licenses list --prod --json > artifacts/licenses-node.json",
    "package:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "esbuild": "0.28.1",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
